---
import SectionLabel from "./SectionLabel.astro";
import IconCalendar from "./IconCalendar.astro";
import IconMapPin from "./IconMapPin.astro";
import IconExternalLink from "./IconExternalLink.astro";
import IconPlay from "./IconPlay.astro";

interface Event {
  name: string;
  date: Date;
  location: { name: string; lat: number; lng: number };
  thumbnail: string;
  photos?: string[];
  feedbackLink?: string;
  videoLink?: string;
}

interface Props {
  events: Event[];
}

const { events } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<aside class="events-col">
  <SectionLabel label="Événements" tight />
  <ol class="events-list" aria-label="Événements">
    {
      events.map((event, i) => (
        <li class="event-item">
          <span class="event-num" aria-hidden="true">
            {pad(i)}
          </span>
          <div class="event-details">
            <p class="event-name">{event.name}</p>
            <p class="event-meta-row">
              <IconCalendar aria-hidden="true" />
              <time datetime={event.date.toISOString()}>
                {formatDate(event.date)}
              </time>
            </p>
            <p class="event-meta-row">
              <IconMapPin aria-hidden="true" />
              {event.location.name}
            </p>
            {(event.feedbackLink || event.videoLink) && (
              <div class="event-links">
                {event.feedbackLink && (
                  <a
                    href={event.feedbackLink}
                    class="event-link event-link--avis"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <IconExternalLink aria-hidden="true" />
                    Avis
                  </a>
                )}
                {event.videoLink && (
                  <a
                    href={event.videoLink}
                    class="event-link event-link--video"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <IconPlay aria-hidden="true" />
                    Vidéo
                  </a>
                )}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</aside>

<style>
  .events-col {
    position: sticky;
    top: 5rem;
  }

  .events-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .event-item {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-top: 1px solid var(--color-border);
    padding: 1.25rem 0;
  }

  .event-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .event-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .event-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .event-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.3;
  }

  .event-meta-row {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
  }

  .event-meta-row svg {
    flex-shrink: 0;
  }

  .event-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }

  .event-link {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .event-link--avis {
    color: var(--color-accent);
  }

  .event-link--video {
    color: var(--color-accent-2);
  }

  @media (max-width: 768px) {
    .events-col {
      position: static;
      top: auto;
    }
  }
</style>
