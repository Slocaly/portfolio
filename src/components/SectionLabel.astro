---
interface Props {
  label: string;
  tight?: boolean;
  /** Keeps the label in place across page transitions (use once per page). */
  persist?: boolean;
}

const { label, tight = false, persist = false } = Astro.props;
---

<div
  class:list={["section-label", { "section-label--tight": tight }]}
  style={persist ? "view-transition-name: author-label" : undefined}
>
  <span class="section-rule" aria-hidden="true"></span>
  <span class="section-name">{label}</span>
</div>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 2rem;
  }
  .section-label--tight { margin-bottom: 0.5rem; }
  .section-rule {
    display: block;
    width: 1.75rem;
    height: 1px;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .section-name {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
</style>
