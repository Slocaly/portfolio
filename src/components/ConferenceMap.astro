---
import SectionLabel from "./SectionLabel.astro";

interface EventLocation {
  name: string;
  lat: number;
  lng: number;
}

interface Props {
  locations: EventLocation[];
}

const { locations } = Astro.props;
const unique = [...new Map(locations.map((l) => [l.name, l])).values()];
---

<div class="map-wrapper">
  <SectionLabel label="Lieux" />
  <div id="conference-map" data-locations={JSON.stringify(unique)}></div>
</div>

<style is:global>
  @import "leaflet/dist/leaflet.css";
</style>

<style>
  .map-wrapper {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem 6rem;
  }

  #conference-map {
    height: 420px;
    width: 100%;
    border-radius: 8px;
    z-index: 0;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    #conference-map {
      height: 260px;
    }
  }
</style>

<script>
  const TILES = {
    light: "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
    dark: "https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png",
  };
  const ATTR =
    '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors © <a href="https://carto.com/attributions">CARTO</a>';

  const isDark = () => document.documentElement.dataset.theme === "dark";

  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("conference-map");
    if (!el) return;

    const observer = new IntersectionObserver(
      async (entries) => {
        if (!entries[0].isIntersecting) return;
        observer.disconnect();

        const { default: L } = await import("leaflet");

        const locations = JSON.parse(el.dataset.locations!) as {
          name: string;
          lat: number;
          lng: number;
        }[];

        const map = L.map("conference-map", {
          scrollWheelZoom: false,
        }).setView([46.5, 2.3], 6);

        let tileLayer = L.tileLayer(isDark() ? TILES.dark : TILES.light, {
          attribution: ATTR,
          subdomains: "abcd",
          maxZoom: 19,
        }).addTo(map);

        new MutationObserver(() => {
          tileLayer.setUrl(isDark() ? TILES.dark : TILES.light);
        }).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });

        const accentColor = getComputedStyle(document.documentElement)
          .getPropertyValue("--color-accent")
          .trim();

        for (const loc of locations) {
          L.circleMarker([loc.lat, loc.lng], {
            radius: 7,
            fillColor: accentColor,
            color: isDark() ? "#1a1916" : "#ffffff",
            weight: 2,
            opacity: 1,
            fillOpacity: 0.9,
          })
            .bindTooltip(loc.name)
            .addTo(map);
        }

        if (locations.length === 1) {
          map.setView([locations[0].lat, locations[0].lng], 10);
        } else {
          const bounds = L.latLngBounds(locations.map((l) => [l.lat, l.lng]));
          map.fitBounds(bounds, { padding: [40, 40] });
        }
      },
      { rootMargin: "200px" }
    );

    observer.observe(el);
  });
</script>
