---
const socials = {
  github: "https://google.com",
  linkedin: "https://google.com",
  bluesky: "https://google.com",
  email: "https://google.com",
};
---

<section class="hero">
  <p class="ghost" aria-hidden="true">Frontend</p>

  <div class="content">
    <p class="eyebrow">Développeur Frontend</p>
    <h1 class="name">
      Lucas<br />
      Audart
    </h1>
    <p class="bio">
      Je conçois et développe des interfaces web modernes, accessibles et
      performantes — du prototype à la mise en production.
    </p>
    <ul class="socials">
      <li>
        <a href={socials.github} aria-label="github">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.9-2.78.6-3.37-1.34-3.37-1.34-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.34-1.11.62-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.32 2.75-1.05 2.75-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.64 1.03 2.76 0 3.94-2.35 4.81-4.58 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
          </svg>
        </a>
      </li>
      <li>
        <a href={socials.linkedin} aria-label="linkedin">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M19 3A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3H19M18.5 18.5V13.2A3.26 3.26 0 0 0 15.24 9.94C14.39 9.94 13.4 10.46 12.92 11.24V10.13H10.13V18.5H12.92V13.57C12.92 12.8 13.54 12.17 14.31 12.17A1.4 1.4 0 0 1 15.71 13.57V18.5H18.5M6.88 8.56A1.68 1.68 0 0 0 8.56 6.88C8.56 5.95 7.81 5.19 6.88 5.19A1.69 1.69 0 0 0 5.19 6.88C5.19 7.81 5.95 8.56 6.88 8.56M8.27 18.5V10.13H5.5V18.5H8.27Z" />
          </svg>
        </a>
      </li>
      <li>
        <a href={socials.bluesky} aria-label="bluesky">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.86 1.5 1.225 1.5 3.225c0 .4.232 3.348.367 3.83.473 1.673 2.156 2.107 3.67 1.847-2.652.452-3.336 1.952-1.875 3.452 2.79 2.871 4.07-.62 4.338-1.418.27.8 1.55 4.288 4.338 1.418 1.46-1.5.776-3-1.876-3.452 1.515.26 3.198-.174 3.67-1.847.136-.482.368-3.43.368-3.83 0-2-1.066-2.365-3.702-.42C16.046 4.747 13.087 8.686 12 10.8Z" />
          </svg>
        </a>
      </li>
      <li>
        <a href={socials.email} aria-label="email">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 6-10 7L2 6" />
          </svg>
        </a>
      </li>
    </ul>
  </div>

  <div class="visual">
    <div class="block">
      <svg
        class="figure"
        viewBox="0 0 200 280"
        preserveAspectRatio="xMidYMin meet"
        aria-hidden="true"
      >
        <circle cx="100" cy="70" r="48"></circle>
        <path d="M20 280 C20 180 50 150 100 150 C150 150 180 180 180 280 Z"
        ></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--wide-width);
    margin: 0 auto;
    padding: var(--space-2) var(--space-2) var(--space-5);
  }

  .ghost {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(5rem, 28vw, 16rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-border);
    white-space: nowrap;
    z-index: 0;
    user-select: none;
  }

  .content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .eyebrow {
    margin: 0;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  .name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 16vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .bio {
    max-width: 32rem;
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .socials {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: var(--space-1) 0 0;
  }

  .socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    color: var(--color-text-muted);
  }

  .socials a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .socials svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .visual {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  .block {
    position: relative;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    background: var(--color-block);
    border-radius: 0.5rem;
    overflow: visible;
  }

  .figure {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 115%;
    fill: var(--color-text);
  }

  @media (min-width: 64rem) {
    .hero {
      display: grid;
      grid-template-columns: 3fr 2fr;
      align-items: center;
      gap: var(--space-5);
      padding: var(--space-5) var(--space-2);
    }

    .block {
      max-width: 26rem;
    }
  }
</style>
