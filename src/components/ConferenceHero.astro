---
import { getImage, Image } from "astro:assets";

interface Props {
  title: string;
  tags: string[];
  eventsCount: number;
  thumbnail?: ImageMetadata;
  coSpeaker?: {
    name: string;
  };
  slides?: string;
  videoLink?: string;
}

const { title, tags, eventsCount, thumbnail, coSpeaker, slides, videoLink } = Astro.props;

const placeholderImage = thumbnail
  ? await getImage({ src: thumbnail, format: "avif", width: 20 })
  : undefined;
---

<div class:list={["hero", { "hero--no-thumbnail": !thumbnail }]}>
  {thumbnail && (
    <div
      class="hero-bg-placeholder"
      aria-hidden="true"
      style={`background-image: url('${placeholderImage?.src}')`}
    />
  )}
  {thumbnail && (
    <Image
      src={thumbnail}
      width={1600}
      widths={[800, 1200, 1600]}
      sizes="100vw"
      format="avif"
      fetchpriority="high"
      loading="eager"
      class="hero-bg-img"
      alt=""
      aria-hidden="true"
    />
  )}
  <div class="hero-gradient" aria-hidden="true"></div>
  <div class="hero-top-bar">
    <a href="/conferences" class="back-link" id="back-link">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      Conférences
    </a>
  </div>
  <div class="hero-content">
    <div class="hero-inner">
      <div class="tags" role="list">
        {
          tags.map((tag, i) => (
            <span
              role="listitem"
              class:list={["tag", { "tag--primary": i === 0 }]}
            >
              {tag}
            </span>
          ))
        }
      </div>
      <h1 class="hero-title">{title}</h1>
      <div class="hero-meta">
        <span class="meta-author">
          {coSpeaker ? `Lucas Audart & ${coSpeaker.name}` : "Lucas Audart"}
        </span>
        <span class="meta-divider" aria-hidden="true"></span>
        <span class="meta-count"
          >{eventsCount} événement{eventsCount > 1 ? "s" : ""}</span
        >
        {(slides || videoLink) && (
          <>
            <span class="meta-divider meta-divider--links" aria-hidden="true"></span>
            <div class="quick-links">
              {slides && (
                <>
                  <a href={slides} target="_blank" rel="noopener noreferrer" class="quick-link" aria-label="Voir les slides (nouvelle fenêtre)" aria-describedby="slides-tooltip" data-tooltip="slides-tooltip">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                      <path d="M8 21h8M12 17v4"></path>
                    </svg>
                  </a>
                  <div id="slides-tooltip" popover="manual" class="quick-link-tooltip">Slides</div>
                </>
              )}
              {videoLink && (
                <>
                  <a href={videoLink} target="_blank" rel="noopener noreferrer" class="quick-link" aria-label="Voir la vidéo (nouvelle fenêtre)" aria-describedby="video-tooltip" data-tooltip="video-tooltip">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m22 8-6 4 6 4V8z"></path>
                      <rect x="2" y="6" width="14" height="12" rx="2"></rect>
                    </svg>
                  </a>
                  <div id="video-tooltip" popover="manual" class="quick-link-tooltip">Vidéo</div>
                </>
              )}
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    height: clamp(420px, 52vh, 800px);
    background-color: #1a1915;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-bg-placeholder {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(20px);
    transform: scale(1.1);
    transition: opacity 0.4s ease;
  }

  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .hero--loaded .hero-bg-img {
    opacity: 1;
  }

  .hero--loaded .hero-bg-placeholder {
    opacity: 0;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(26, 25, 21, 0.8) 0%,
      rgba(26, 25, 21, 0.05) 20%,
      rgba(26, 25, 21, 0.05) 40%,
      rgba(26, 25, 21, 0.92) 100%
    );
  }

  .hero-top-bar,
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
  }

  .hero-top-bar {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .hero-content {
    padding-bottom: 2.5rem;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
  }

  .back-link:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 2px;
    color: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .tag--primary {
    color: #e8876a;
    border-color: #e8876a;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #fff;
    max-width: 48rem;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .meta-author {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.01em;
  }

  .meta-count,
  .meta-topics {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .meta-divider {
    display: block;
    width: 1px;
    height: 1rem;
    background: rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
  }

  .quick-links {
    display: flex;
    gap: 0.5rem;
  }

  .quick-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0.375rem;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
    transition: color 0.2s ease-in-out, border-color 0.2s ease-in-out;
  }

  .quick-link:hover {
    color: rgba(255, 255, 255, 1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .quick-link svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .quick-link-tooltip {
    position: fixed;
    inset: unset;
    margin: 0;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.95);
    color: #1a1915;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 3px;
    border: none;
    white-space: nowrap;
    pointer-events: none;
    transform: translateX(-50%) translateY(calc(-100% - 8px));
  }

  .quick-link-tooltip::backdrop {
    display: none;
  }

  @media (max-width: 480px) {
    .meta-topics,
    .meta-divider--links {
      display: none;
    }
  }

  /* --- no-thumbnail variant --- */
  .hero--no-thumbnail {
    height: auto;
    background-color: var(--color-bg);
  }

  .hero--no-thumbnail .hero-gradient {
    display: none;
  }

  .hero--no-thumbnail .back-link {
    color: var(--color-text-muted);
  }

  .hero--no-thumbnail .back-link:hover {
    color: var(--color-text);
  }

  .hero--no-thumbnail .tag {
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  .hero--no-thumbnail .tag--primary {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .hero--no-thumbnail .hero-title {
    color: var(--color-text);
  }

  .hero--no-thumbnail .meta-author {
    color: var(--color-text);
  }

  .hero--no-thumbnail .meta-count {
    color: var(--color-text-muted);
  }

  .hero--no-thumbnail .meta-divider {
    background: var(--color-border);
  }

  .hero--no-thumbnail .quick-link {
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  .hero--no-thumbnail .quick-link:hover {
    color: var(--color-text);
    border-color: var(--color-text-muted);
  }

  .hero--no-thumbnail .quick-link-tooltip {
    background: var(--color-text);
    color: var(--color-bg);
  }
</style>

<script>
  const link = document.getElementById("back-link") as HTMLAnchorElement | null;
  if (link) {
    const stored = sessionStorage.getItem("conferences-back");
    if (stored) link.href = stored;
  }

  function initHeroLqip() {
    const img = document.querySelector(".hero-bg-img") as HTMLImageElement | null;
    const hero = document.querySelector(".hero") as HTMLElement | null;
    if (img && hero) {
      if (img.complete) {
        hero.classList.add("hero--loaded");
      } else {
        img.addEventListener("load", () => hero.classList.add("hero--loaded"));
      }
    }
  }
  document.addEventListener("astro:page-load", initHeroLqip);

  function initQuickLinkTooltips() {
    document.querySelectorAll<HTMLElement>(".quick-link[data-tooltip]").forEach((link) => {
      const tooltip = document.getElementById(link.dataset.tooltip!) as HTMLElement | null;
      if (!tooltip) return;

      const show = () => {
        const rect = link.getBoundingClientRect();
        tooltip.style.left = `${rect.left + rect.width / 2}px`;
        tooltip.style.top = `${rect.top}px`;
        (tooltip as any).showPopover();
      };
      const hide = () => (tooltip as any).hidePopover();

      link.addEventListener("mouseenter", show);
      link.addEventListener("mouseleave", hide);
      link.addEventListener("focus", show);
      link.addEventListener("blur", hide);
    });
  }
  document.addEventListener("astro:page-load", initQuickLinkTooltips);
</script>
