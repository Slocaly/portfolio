---
interface Props {
  title: string;
  tags: string[];
  eventsCount: number;
  thumbnail?: string;
  coSpeaker?: {
    name: string;
  }
}

const { title, tags, eventsCount, thumbnail, coSpeaker } = Astro.props;
---

<div
  class="hero"
  style={thumbnail ? `background-image: url('${thumbnail}')` : undefined}
>
  <div class="hero-gradient" aria-hidden="true"></div>
  <div class="hero-top-bar">
    <a href="/conferences" class="back-link" id="back-link">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      Conférences
    </a>
  </div>
  <div class="hero-content">
    <div class="hero-inner">
      <div class="tags" role="list">
        {
          tags.map((tag, i) => (
            <span
              role="listitem"
              class:list={["tag", { "tag--primary": i === 0 }]}
            >
              {tag}
            </span>
          ))
        }
      </div>
      <h1 class="hero-title">{title}</h1>
      <div class="hero-meta">
        <span class="meta-author">
          {coSpeaker ? `Lucas Audart & ${coSpeaker.name}` : "Lucas Audart"}
        </span>
        <span class="meta-divider" aria-hidden="true"></span>
        <span class="meta-count"
          >{eventsCount} événement{eventsCount > 1 ? "s" : ""}</span
        >
      </div>
    </div>
  </div>
</div>

<style>
  .hero {
    position: relative;
    height: clamp(420px, 52vh, 800px);
    background-color: #1a1915;
    background-size: cover;
    background-position: center;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(26, 25, 21, 0.80) 0%,
      rgba(26, 25, 21, 0.05) 20%,
      rgba(26, 25, 21, 0.05) 40%,
      rgba(26, 25, 21, 0.92) 100%
    );
  }

  .hero-top-bar,
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
  }

  .hero-top-bar {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .hero-content {
    padding-bottom: 2.5rem;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    text-decoration: none;
  }

  .back-link:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 2px;
    color: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .tag--primary {
    color: #e8876a;
    border-color: #e8876a;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #fff;
    max-width: 48rem;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .meta-author {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.01em;
  }

  .meta-count,
  .meta-topics {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .meta-divider {
    display: block;
    width: 1px;
    height: 1rem;
    background: rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .meta-topics,
    .meta-divider:last-of-type {
      display: none;
    }
  }
</style>

<script>
  const link = document.getElementById("back-link") as HTMLAnchorElement | null;
  if (link) {
    const stored = sessionStorage.getItem("conferences-back");
    if (stored) link.href = stored;
  }
</script>
