---
import "../styles/global.css";
import VerticalLabel from "../components/VerticalLabel.astro";
import { ClientRouter } from "astro:transitions";

const { title = "Lucas Audart - Développeur Frontend", description = "" } =
	Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<ClientRouter />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@700;800&family=Archivo:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<script is:inline>
			const stored = document.cookie
				.split("; ")
				.find((row) => row.startsWith("theme="))
				?.split("=")[1];
			const theme =
				stored ??
				(window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light");
			document.documentElement.dataset.theme = theme;
		</script>
		<script is:inline>
			const PAGE_ORDER = ["/", "/about", "/conferences"];

			function getPageRank(pathname) {
				const idx = PAGE_ORDER.findIndex((p) =>
					p === "/" ? pathname === "/" : pathname.startsWith(p),
				);
				return idx === -1 ? 0 : idx;
			}

			let nextDirection = "forward";
			let nextTransition = "default";

			const isDetailPath = (p) => p.startsWith("/conferences/") && !CONF_TABS.includes(p);

			const CONF_TABS = [
				"/conferences",
				"/conferences/talk",
				"/conferences/conference",
			];

			document.addEventListener("astro:before-preparation", (e) => {
				const fromPath = window.location.pathname;
				const toPath = e.to.pathname;

				if (
					CONF_TABS.includes(fromPath) &&
					toPath.startsWith("/conferences/") &&
					!CONF_TABS.includes(toPath)
				) {
					sessionStorage.setItem("conferences-back", fromPath);
				}

				if (isDetailPath(fromPath) || isDetailPath(toPath)) {
					nextTransition = "conference";
				} else {
					nextTransition = "default";
					const from = getPageRank(fromPath);
					const to = getPageRank(toPath);
					nextDirection = to >= from ? "forward" : "backward";
				}
			});

			document.addEventListener("astro:after-swap", () => {
				const stored = document.cookie
					.split("; ")
					.find((row) => row.startsWith("theme="))
					?.split("=")[1];
				document.documentElement.dataset.theme =
					stored ??
					(window.matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light");

				if (nextTransition === "conference") {
					document.documentElement.dataset.transition = "conference";
					delete document.documentElement.dataset.direction;
				} else {
					delete document.documentElement.dataset.transition;
					document.documentElement.dataset.direction = nextDirection;
				}
			});
		</script>
		<slot name="head" />
	</head>
	<body>
		<VerticalLabel />
		<slot />
	</body>
</html>
