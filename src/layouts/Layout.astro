---
import "../styles/global.css";
import VerticalLabel from "../components/VerticalLabel.astro";
import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import ProfileImage from "../assets/home/profil.png";

const { title = "Lucas Audart - Développeur Frontend", description = "" } =
	Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: ProfileImage, width: 1200, height: 1200 });
const ogImageURL = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Lucas Audart" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="1200" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<ClientRouter />
		<link rel="preload" href="/fonts/archivo-400.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/archivo-expanded-700.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/archivo-expanded-800.woff2" as="font" type="font/woff2" crossorigin />
		<script is:inline>
			const stored = document.cookie
				.split("; ")
				.find((row) => row.startsWith("theme="))
				?.split("=")[1];
			const theme =
				stored ??
				(window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light");
			document.documentElement.dataset.theme = theme;
		</script>
		<script is:inline>
			const PAGE_ORDER = ["/", "/about", "/conferences"];

			function getPageRank(pathname) {
				const idx = PAGE_ORDER.findIndex((p) =>
					p === "/" ? pathname === "/" : pathname.startsWith(p),
				);
				return idx === -1 ? 0 : idx;
			}

			let nextDirection = "forward";
			let nextTransition = "default";

			const isDetailPath = (p) =>
				p.startsWith("/conferences/") && !CONF_TABS.includes(p);

			const CONF_TABS = [
				"/conferences",
				"/conferences/talk",
				"/conferences/conference",
				"/conferences/lieu",
			];

			document.addEventListener("astro:before-preparation", (e) => {
				const norm = (p) => (p === "/" ? p : p.replace(/\/$/, ""));
				const fromPath = norm(window.location.pathname);
				const toPath = norm(e.to.pathname);

				if (
					CONF_TABS.includes(fromPath) &&
					toPath.startsWith("/conferences/") &&
					!CONF_TABS.includes(toPath)
				) {
					sessionStorage.setItem("conferences-back", fromPath);
				}

				if (
					CONF_TABS.includes(fromPath) &&
					CONF_TABS.includes(toPath)
				) {
					nextTransition = "tab";
				} else {
					if (isDetailPath(fromPath) || isDetailPath(toPath)) {
						nextTransition = "conference";
					} else {
						nextTransition = "default";
						const from = getPageRank(fromPath);
						const to = getPageRank(toPath);
						nextDirection = to >= from ? "forward" : "backward";
					}
				}
			});

			document.addEventListener("astro:after-swap", () => {
				const stored = document.cookie
					.split("; ")
					.find((row) => row.startsWith("theme="))
					?.split("=")[1];
				document.documentElement.dataset.theme =
					stored ??
					(window.matchMedia("(prefers-color-scheme: dark)").matches
						? "dark"
						: "light");

				if (
					nextTransition === "conference" ||
					nextTransition === "tab"
				) {
					document.documentElement.dataset.transition =
						nextTransition;
					delete document.documentElement.dataset.direction;
				} else {
					delete document.documentElement.dataset.transition;
					document.documentElement.dataset.direction = nextDirection;
				}
			});
		</script>
		<slot name="head" />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Aller au contenu principal</a>
		<main role="main" id="main-content">
			<slot />
		</main>
		<VerticalLabel />
	</body>
</html>
