---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import SectionLabel from "../components/SectionLabel.astro";
---

<Layout
  title="Page introuvable — Lucas Audart"
  description="Cette page n'existe pas ou a été déplacée."
>
  <Navigation />

  <section class="hero">
    <div class="wrap">
      <SectionLabel label="Lucas Audart" />
      <p class="code">404</p>
      <h1 class="hero-title">Page introuvable</h1>
      <p class="hero-intro">
        Cette page n'existe pas, a été déplacée, ou l'URL comporte une
        erreur.
      </p>
      <a href="/" class="home-link">← Retour à l'accueil</a>
    </div>
  </section>
</Layout>

<style>
  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hero {
    padding: 4.5rem 0 6rem;
  }

  .code {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 9vw, 7rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-accent);
  }

  .hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    letter-spacing: -0.025em;
    color: var(--color-text);
    line-height: 1.1;
    margin: 0 0 1.25rem;
  }

  .hero-intro {
    max-width: 32rem;
    margin: 0 0 2.5rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }

  .home-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 1.5rem;
    }
  }
</style>
