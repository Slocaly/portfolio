---
import Navigation from "../components/Navigation.astro";
import Layout from "../layouts/Layout.astro";
import SectionLabel from "../components/SectionLabel.astro";
---

<Layout
  title="Blog"
  description="Découvrez mes articles sur le développement web, les technologies et les conférences auxquelles j'ai participé."
>
  <Navigation />

  <section class="hero">
    <div class="wrap">
      <SectionLabel label="Lucas Audart" />
      <h1 class="hero-title">Blog</h1>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 4.5rem 0 3.25rem;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.75rem, 6vw, 5rem);
    letter-spacing: -0.025em;
    color: var(--color-text);
    line-height: 1;
    margin: 0 0 2rem;
  }
  .hero-intro {
    max-width: 42rem;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 1.5rem;
    }
  }
</style>
